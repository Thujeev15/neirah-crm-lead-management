              "mode": "raw",
              "raw": "{\n  \"type\": \"CALL\",\n  \"title\": \"Customer Follow-up\",\n  \"description\": \"Discuss pricing with customer\",\n  \"dueAt\": \"2026-12-01T10:30:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
