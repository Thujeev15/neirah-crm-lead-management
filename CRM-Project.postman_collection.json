    {
      "name": "Conversion",
      "description": "",
      "item": [
        {
          "name": "Convert Lead",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/{{leadId}}/convert",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "leads",
                "{{leadId}}",
                "convert"
              ]
            },
            "description": "Convert a Won lead. Repeat calls return the existing customer (alreadyConverted=true). If another customer already has the same email, the lead is linked to it (linkedToExistingCustomer=true) instead of creating a duplicate."
          }
        },
        {
          "name": "Get Converted Customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/{{leadId}}/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "leads",
                "{{leadId}}",
                "customer"
              ]
            },
            "description": "Returns the customer created from this lead, or 404 if it has not been converted."
          }
        }
      ]
