                "complete"
              ]
            },
            "description": "Marks the specified follow-up as complete. No request body is defined by the controller contract supplied."
          }
        },
        {
          "name": "List Follow-ups (all visible leads)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/follow-ups?status=OVERDUE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "follow-ups"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "OVERDUE"
                }
              ]
            },
            "description": "Cross-lead schedule. status = ALL | UPCOMING | OVERDUE | COMPLETED. Managers see all leads; sales reps see leads they own. Overdue is computed from dueAt and completedAt."
          }
        }
      ]
