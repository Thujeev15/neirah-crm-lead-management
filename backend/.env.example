# Example only - copy the values into your shell (export ...) or IDE run configuration.
# Spring Boot reads these as environment variables; never commit real values.

# Password for the MySQL root user used by jdbc:mysql://localhost:3306/crm_db
DB_PASSWORD=your_mysql_password

# HMAC signing key for JWTs - must be at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
