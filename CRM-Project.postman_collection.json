{
  "info": {
    "name": "CRM Project API",
    "description": "Postman collection generated from the implemented Spring Boot controllers and DTOs. Base URL defaults to http://localhost:8080. Login is public; all other API requests use Bearer JWT authentication. Set collection variables before testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "leadId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "followUpId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "leadOwnerEmail",
      "value": "ravi@neirah.demo",
      "type": "string"
    },
    {
      "key": "resetUserEmail",
      "value": "ravi@neirah.demo",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Register and login do not require JWT.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Public endpoint. On success, saves response.token to the collection variable {{token}}. Seeded demo accounts: manager@neirah.demo, ravi@neirah.demo, nisha@neirah.demo, arun@neirah.demo (password Demo@1234). The token is saved to {{token}} automatically.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@neirah.demo\",\n  \"password\": \"Demo@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data && data.token) { pm.collectionVariables.set('token', data.token); }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
