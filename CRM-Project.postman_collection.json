{
  "info": {
    "name": "CRM Project API",
    "description": "Postman collection generated from the implemented Spring Boot controllers and DTOs. Base URL defaults to http://localhost:8080. Register/Login are public; all other API requests use Bearer JWT authentication. Set collection variables before testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "leadId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "followUpId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "leadOwnerEmail",
      "value": "sales@example.com",
      "type": "string"
    },
    {
      "key": "resetUserEmail",
      "value": "sales@example.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Register and login do not require JWT.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Public endpoint. RegisterRequest: fullName, valid email, password (minimum 8 characters).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Silva\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Public endpoint. On success, saves response.token to the collection variable {{token}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data && data.token) { pm.collectionVariables.set('token', data.token); }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
